# Wind editor SDK, $<CONFIG> configuration. Generated by the engine's CMakeLists.txt from
# cmake/wind_sdk.cmake.in and installed as <sdk>/cmake/wind_sdk.cmake. Do not edit.
# Included by the engine's root CMakeLists.txt when a game sets WIND_EDITOR_SDK. docs/tech/build/CMake.md
#
# Defines the imported targets `engine` (engine::engine), `glm::glm`, `asset_codegen`, and `icon_codegen`
# from this SDK, then includes wind_game.cmake. engine's compile definitions are the ones the SDK was built
# with, fixed for every configuration of the game.

include_guard(GLOBAL)

get_filename_component(_wind_sdk_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

# Cache entries: the game functions run in the game's directory scope and read them from there.
set(WIND_EDITOR_SDK_DIR "${_wind_sdk_dir}" CACHE INTERNAL "Wind editor SDK root")
set(WIND_SDK_CONFIG "$<CONFIG>" CACHE INTERNAL "Configuration the Wind editor SDK was built in")
set(ENGINE_FROM_SDK ON CACHE INTERNAL "Wind engine imported from WIND_EDITOR_SDK")
set(ENGINE_BUILTIN_ASSETS_DIR "${_wind_sdk_dir}/bin/assets/engine" CACHE INTERNAL
    "Engine builtin assets (already cooked in the SDK)")
set(ENGINE_COOKED_CATALOG "${_wind_sdk_dir}/bin/assets/engine/catalog.toml" CACHE INTERNAL
    "Cooked catalog.toml for engine builtins")

set(_wind_sdk_defines "$<TARGET_PROPERTY:engine,INTERFACE_COMPILE_DEFINITIONS>")
list(REMOVE_ITEM _wind_sdk_defines "")

add_library(glm::glm INTERFACE IMPORTED GLOBAL)
set_target_properties(glm::glm PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_wind_sdk_dir}/include")

set(_wind_sdk_link glm::glm)
if(WIN32)
    # PUBLIC on the source build's engine (cli_server.cpp: WinSock and the ACL APIs).
    list(APPEND _wind_sdk_link ws2_32 advapi32)
endif()

# IMPORTED_LOCATION without a configuration suffix serves every configuration of the game.
add_library(engine SHARED IMPORTED GLOBAL)
set_target_properties(engine PROPERTIES
    IMPORTED_LOCATION "${_wind_sdk_dir}/bin/$<TARGET_FILE_NAME:engine>"
    IMPORTED_IMPLIB "${_wind_sdk_dir}/lib/$<TARGET_LINKER_FILE_NAME:engine>"
    INTERFACE_INCLUDE_DIRECTORIES "${_wind_sdk_dir}/include"
    INTERFACE_COMPILE_DEFINITIONS "${_wind_sdk_defines}"
    INTERFACE_COMPILE_FEATURES cxx_std_23
    INTERFACE_LINK_LIBRARIES "${_wind_sdk_link}")
add_library(engine::engine ALIAS engine)

add_executable(asset_codegen IMPORTED GLOBAL)
set_target_properties(asset_codegen PROPERTIES
    IMPORTED_LOCATION "${_wind_sdk_dir}/bin/$<TARGET_FILE_NAME:asset_codegen>")
add_executable(icon_codegen IMPORTED GLOBAL)
set_target_properties(icon_codegen PROPERTIES
    IMPORTED_LOCATION "${_wind_sdk_dir}/bin/$<TARGET_FILE_NAME:icon_codegen>")

foreach(_wind_sdk_file IN ITEMS
        "${_wind_sdk_dir}/bin/$<TARGET_FILE_NAME:engine>"
        "${_wind_sdk_dir}/lib/$<TARGET_LINKER_FILE_NAME:engine>"
        "${_wind_sdk_dir}/bin/$<TARGET_FILE_NAME:asset_codegen>"
        "${_wind_sdk_dir}/bin/$<TARGET_FILE_NAME:icon_codegen>"
        "${_wind_sdk_dir}/include/engine/build_id.h"
        "${ENGINE_COOKED_CATALOG}")
    if(NOT EXISTS "${_wind_sdk_file}")
        message(FATAL_ERROR "Wind editor SDK at ${_wind_sdk_dir} is incomplete: missing ${_wind_sdk_file}")
    endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/wind_game.cmake")

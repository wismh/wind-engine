# Wind player libraries, @ENGINE_PLAYER@ flavour. Generated by the engine's CMakeLists.txt from cmake/wind_player.cmake.in
# and installed as <sdk>/player/@ENGINE_PLAYER@/cmake/wind_player.cmake. Do not edit. docs/tech/build/CMake.md
#
# What WindConfig.cmake reads in an export build (-DWIND_EXPORT=ON) before it includes wind_player_targets.cmake, the
# imported targets WindPlayer@ENGINE_PLAYER@::engine and what it links.

set(WIND_PLAYER_FLAVOUR "@ENGINE_PLAYER@")
# project(engine VERSION) these libraries were built from: the three numbers, like Wind_VERSION.
set(WIND_PLAYER_VERSION "@PROJECT_VERSION@")
set(WIND_PLAYER_PLATFORM "@WIND_PLAYER_PLATFORM@")
# kBuildId of the editor SDK that installed them. WindConfig.cmake compares it with the SDK's own
# include/engine/build_id.h, so libraries of another build never meet this SDK's headers.
set(WIND_PLAYER_SDK_BUILD_ID "@WIND_PLAYER_SDK_BUILD_ID@")

# What the exported targets refer to besides themselves: the system OpenGL library (the engine, with a window), the
# thread library (spdlog), and, in a Linux Server player, the libraries GameNetworkingSockets was built against.
if(@WIND_PLAYER_NEEDS_OPENGL@ AND NOT TARGET OpenGL::GL)
    find_package(OpenGL REQUIRED)
endif()
if(NOT TARGET Threads::Threads)
    find_package(Threads REQUIRED)
endif()
if(@WIND_PLAYER_NEEDS_GNS_DEPENDENCIES@)
    set(Protobuf_USE_STATIC_LIBS ON)
    set(OPENSSL_USE_STATIC_LIBS ON)
    if(NOT TARGET OpenSSL::Crypto)
        find_package(OpenSSL REQUIRED)
    endif()
    if(NOT TARGET protobuf::libprotobuf)
        find_package(Protobuf REQUIRED)
    endif()
endif()

{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-msvc",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "vs",
      "displayName": "Windows MSVC (Ninja Multi-Config)",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_WITH_WINDOW": "OFF",
        "ENGINE_WITH_AUDIO": "OFF"
      }
    },
    {
      "name": "vs-window",
      "displayName": "Windows MSVC + OpenGL window backend",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build-window",
      "cacheVariables": {
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_AUDIO": "OFF"
      }
    },
    {
      "name": "vs-audio",
      "displayName": "Windows MSVC + SDL3_mixer WAV backend",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build-audio",
      "cacheVariables": {
        "ENGINE_BUILD_TESTS": "OFF",
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_AUDIO": "ON"
      }
    },
    {
      "name": "vs-editor",
      "displayName": "Windows editor build (Ninja Multi-Config, shared engine.dll)",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build-editor",
      "cacheVariables": {
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_AUDIO": "ON",
        "ENGINE_EDITOR": "ON"
      }
    },
    {
      "name": "linux-editor",
      "displayName": "Linux editor build (shared libengine.so, Ninja Multi-Config)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-editor",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_AUDIO": "ON",
        "ENGINE_EDITOR": "ON"
      }
    },
    {
      "name": "macos-editor",
      "displayName": "macOS editor build (shared libengine.dylib, Ninja Multi-Config)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-editor",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_AUDIO": "ON",
        "ENGINE_EDITOR": "ON"
      }
    },
    {
      "name": "vs-bench",
      "displayName": "Windows UI bench (Ninja Multi-Config, measure in RelWithDebInfo)",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/build-bench",
      "cacheVariables": {
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_AUDIO": "OFF",
        "ENGINE_BENCH": "ON"
      }
    },
    {
      "name": "linux-bench",
      "displayName": "Linux UI bench (Ninja, static engine, RelWithDebInfo)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-bench",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_AUDIO": "OFF",
        "ENGINE_BENCH": "ON"
      }
    },
    {
      "name": "web",
      "displayName": "Emscripten WebGL2 (configure with emcmake)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web",
      "cacheVariables": {
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_WEB": "ON",
        "ENGINE_WITH_AUDIO": "OFF"
      }
    },
    {
      "name": "web-audio",
      "displayName": "Emscripten WebGL2 + SDL3_mixer WAV backend (configure with emcmake)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web-audio",
      "cacheVariables": {
        "ENGINE_BUILD_TESTS": "OFF",
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_WEB": "ON",
        "ENGINE_WITH_AUDIO": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android NDK arm64-v8a (configure with NDK toolchain)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-android",
      "toolchainFile": "${sourceDir}/cmake/toolchains/android-ndk.cmake",
      "cacheVariables": {
        "ENGINE_BUILD_TESTS": "ON",
        "ENGINE_WITH_WINDOW": "ON",
        "ENGINE_WITH_ANDROID": "ON",
        "ENGINE_WITH_AUDIO": "OFF",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-21"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "tests",
      "configurePreset": "vs",
      "targets": ["engine_tests"]
    },
    {
      "name": "bench",
      "configurePreset": "vs-bench",
      "configuration": "RelWithDebInfo",
      "targets": ["wind_ui_bench"]
    },
    {
      "name": "linux-bench",
      "configurePreset": "linux-bench",
      "targets": ["wind_ui_bench"]
    }
  ]
}


<!-- Paint-mix scene, box cells styled by the variant sheet (mix_*.css): 25 rows of 40 equal cells, every cell one painter call kind. -->
<Canvas id="paint_mix">
  <Stack class="grid" direction="vertical">
    <Label id="rest" class="title" text="Paint mix"/>
    <ItemsControl class="mix-rows" items_source="{binding rows}">
      <ItemTemplate>
        <ItemsControl class="mix-row" direction="horizontal" items_source="{binding cells}">
          <ItemTemplate>
            <Stack class="cell"/>
          </ItemTemplate>
        </ItemsControl>
      </ItemTemplate>
    </ItemsControl>
  </Stack>
</Canvas>

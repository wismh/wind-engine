<Canvas id="explorer">
  <Stack class="panel" direction="vertical">
    <Stack class="option-row" direction="horizontal">
      <Label class="hint project-path" text="{binding rootText}"/>
      <Stack class="option-spacer"/>
      <Stack class="icon-button" if="{binding gridShown}" command="{binding gridUp}">
        <Svg class="icon-glyph" source="2d7a9c4e6b1f4830a8e5d3c19f7b6042"/>
      </Stack>
      <Stack class="icon-button" command="{binding toggleView}">
        <Svg class="icon-glyph" source="{binding viewIcon}"/>
      </Stack>
    </Stack>
    <ScrollView id="tree" class="box tree fill" if="{binding treeShown}">
      <ContextMenu open="{binding blankMenuOpen}">
        <Menu text="New">
          <MenuItem text="Folder" shortcut="Ctrl+Shift+N" command="{binding blankNewFolder}"/>
          <MenuItem text="World" command="{binding blankNewWorld}"/>
          <MenuItem text="Header" command="{binding blankNewHeader}"/>
          <MenuItem text="Source" command="{binding blankNewSource}"/>
        </Menu>
        <MenuSeparator/>
        <MenuItem text="Paste" shortcut="Ctrl+V" command="{binding blankPaste}"/>
      </ContextMenu>
      <ItemsControl id="tree-rows" class="rows" items_source="{binding rows}">
        <ItemTemplate>
          <Stack class="rowline" direction="horizontal" var-row="{binding rowFill}" var-depth="{binding depth}"
                  command="{binding select}">
            <Checkbox class="expander" checked="{binding expanded}" command="{binding toggle}"/>
            <Svg class="entry-icon" source="{binding icon}" command="{binding select}"/>
            <Button class="row entry" var-row-display="{binding rowDisplay}" command="{binding select}"
                    content="{binding label}"/>
            <TextInput class="rename entry" var-rename-display="{binding renameDisplay}" text="{binding editText}"
                    command="{binding commitRename}"/>
            <ContextMenu open="{binding menuOpen}">
              <Menu text="New">
                <MenuItem text="Folder" shortcut="Ctrl+Shift+N" command="{binding newFolder}"/>
                <MenuItem text="World" command="{binding newWorld}"/>
                <MenuItem text="Header" command="{binding newHeader}"/>
                <MenuItem text="Source" command="{binding newSource}"/>
              </Menu>
              <MenuSeparator/>
              <MenuItem text="Cut" shortcut="Ctrl+X" command="{binding cut}"/>
              <MenuItem text="Copy" shortcut="Ctrl+C" command="{binding copy}"/>
              <MenuItem text="Paste" shortcut="Ctrl+V" command="{binding paste}"/>
              <MenuSeparator/>
              <MenuItem text="Rename" shortcut="F2" command="{binding rename}"/>
              <MenuItem text="Delete" shortcut="Del" command="{binding remove}"/>
            </ContextMenu>
          </Stack>
        </ItemTemplate>
      </ItemsControl>
    </ScrollView>
    <ScrollView id="grid" class="box fill" if="{binding gridShown}" scroll-y="{binding gridScroll}">
      <ContextMenu open="{binding blankMenuOpen}">
        <Menu text="New">
          <MenuItem text="Folder" shortcut="Ctrl+Shift+N" command="{binding blankNewFolder}"/>
          <MenuItem text="World" command="{binding blankNewWorld}"/>
          <MenuItem text="Header" command="{binding blankNewHeader}"/>
          <MenuItem text="Source" command="{binding blankNewSource}"/>
        </Menu>
        <MenuSeparator/>
        <MenuItem text="Paste" shortcut="Ctrl+V" command="{binding blankPaste}"/>
      </ContextMenu>
      <ItemsControl id="grid-tiles" class="tiles" items_source="{binding tiles}">
        <ItemTemplate>
          <Stack class="tile" direction="vertical" var-row="{binding rowFill}" command="{binding select}">
            <Svg class="tile-icon" source="{binding icon}" command="{binding select}"/>
            <Button class="tile-name" var-row-display="{binding rowDisplay}" command="{binding select}"
                    content="{binding label}"/>
            <TextInput class="tile-rename" var-rename-display="{binding renameDisplay}" text="{binding editText}"
                    command="{binding commitRename}"/>
            <ContextMenu open="{binding menuOpen}">
              <Menu text="New">
                <MenuItem text="Folder" shortcut="Ctrl+Shift+N" command="{binding newFolder}"/>
                <MenuItem text="World" command="{binding newWorld}"/>
                <MenuItem text="Header" command="{binding newHeader}"/>
                <MenuItem text="Source" command="{binding newSource}"/>
              </Menu>
              <MenuSeparator/>
              <MenuItem text="Cut" shortcut="Ctrl+X" command="{binding cut}"/>
              <MenuItem text="Copy" shortcut="Ctrl+C" command="{binding copy}"/>
              <MenuItem text="Paste" shortcut="Ctrl+V" command="{binding paste}"/>
              <MenuSeparator/>
              <MenuItem text="Rename" shortcut="F2" command="{binding rename}"/>
              <MenuItem text="Delete" shortcut="Del" command="{binding remove}"/>
            </ContextMenu>
          </Stack>
        </ItemTemplate>
      </ItemsControl>
    </ScrollView>
  </Stack>
</Canvas>

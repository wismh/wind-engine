<Canvas id="editor">
  <Stack class="editor" direction="vertical">
    <Stack class="titlebar" direction="horizontal">
      <Stack class="titlebar-left" direction="horizontal">
        <Image class="app-icon" source="e37ab68ef5a85b2bf93c84c168987296"/>
        <Label class="app-title" text="{binding windowTitle}"/>
        <MenuBar class="main-menu-bar">
          <Menu text="File">
            <MenuItem text="Refresh" command="{binding refreshProject}"/>
            <MenuSeparator/>
            <MenuItem text="Export..." command="{binding exportGame}" shortcut="Ctrl+E"/>
            <MenuSeparator/>
            <MenuItem text="Exit" command="{binding closeWindow}" shortcut="Alt+F4"/>
          </Menu>
          <Menu text="Edit">
            <MenuItem text="Undo" shortcut="Ctrl+Z" command="{binding undo}"/>
            <MenuItem text="Redo" shortcut="Ctrl+Y" command="{binding redo}"/>
          </Menu>
          <Menu text="Window">
            <MenuItem text="Toggle Play" command="{binding togglePlay}" shortcut="F5"/>
            <MenuSeparator/>
            <MenuItem text="Project" command="{binding showProject}"/>
            <MenuItem text="Hierarchy" command="{binding showHierarchy}"/>
            <MenuItem text="World" command="{binding showWorld}"/>
            <MenuItem text="UI Tree" command="{binding showUiTree}"/>
            <MenuItem text="Inspector" command="{binding showInspector}"/>
            <MenuItem text="Profiler" command="{binding showProfiler}"/>
            <MenuItem text="Build" command="{binding showBuild}"/>
          </Menu>
          <Menu text="Help">
            <MenuItem text="About Wind Engine"/>
          </Menu>
        </MenuBar>
      </Stack>
      <Stack class="titlebar-right" direction="horizontal">
        <Label class="project-title" text="{binding projectName}"/>
        <Button class="window-btn min-btn" command="{binding minimizeWindow}" content="_"/>
        <Button class="window-btn max-btn" command="{binding maximizeWindow}" content="{binding maxRestoreLabel}"/>
        <Button class="window-btn close-btn" command="{binding closeWindow}" content="x"/>
      </Stack>
    </Stack>
    <Stack class="toolbar" direction="horizontal">
      <Button class="play-button" command="{binding togglePlay}" checked="{binding isPlaying}" content="{binding playLabel}"/>
    </Stack>
    <!-- Below the toolbar: the panels' dock space, canvases of their own (EditorPanels). -->
  </Stack>
</Canvas>
